{
  "name": "story-factory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Manifest-driven Remotion video factory for a Hindi/Hinglish business-story channel",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate.ts",
    "split": "tsx scripts/split.ts",
    "tts": "tsx scripts/tts.ts",
    "align": "python3 scripts/align.py",
    "plan": "tsx scripts/plan.ts",
    "render": "tsx scripts/render.ts",
    "mix": "tsx scripts/mix.ts",
    "sfx": "python3 scripts/sfx.py",
    "tools:scene-at": "tsx scripts/tools/scene-at.ts",
    "tools:chapters": "tsx scripts/tools/chapters.ts",
    "tools:srt": "tsx scripts/tools/srt.ts",
    "test": "tsx scripts/test-format.ts && tsx scripts/test-validate.ts",
    "stills:demo": "tsx scripts/stills-demo.ts"
  },
  "dependencies": {
    "@remotion/cli": "4.0.532",
    "@remotion/fonts": "4.0.532",
    "@remotion/media-utils": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@remotion/bundler": "4.0.532",
    "remotion": "4.0.532",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.15.0",
    "@types/react": "19.1.8",
    "tsx": "4.19.4",
    "typescript": "5.8.3"
  }
}
